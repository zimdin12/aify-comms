# =============================================================================
# aify-comms — dashboard-driven agent communication and control plane
# =============================================================================
# Copy to .env: cp .env.example .env
# Then: docker compose up -d --build

# -----------------------------------------------------------------------------
# Service Identity
# -----------------------------------------------------------------------------
SERVICE_NAME=aify-comms
# SERVICE_VERSION is derived from the repo-root VERSION file, baked into
# service/_build_stamp.json by scripts/stamp.sh. Setting it here OVERRIDES that
# (env wins over the stamp) and pins the version reported by /, /docs and
# /openapi.json to whatever is typed here — which is how the API kept announcing
# 0.1.0 across the v0.1, v0.1.1 and v0.1.2 releases. Leave it commented.
# SERVICE_VERSION=0.1.0
SERVICE_DESCRIPTION=Dashboard and bridge for spawning, messaging, monitoring, and controlling headless coding agents across connected environments

# -----------------------------------------------------------------------------
# Network / Ports
# -----------------------------------------------------------------------------
# Dashboard: http://localhost:8800/api/v1/dashboard
# API:       http://localhost:8800/api/v1/
SERVICE_PORT=8800

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=aify-comms
DATA_VOLUME_NAME=aify-comms-data
DATA_VOLUME_EXTERNAL=false
RESTART_POLICY=unless-stopped

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
MCP_ENABLED=true
MCP_APP_NAME=claude-code

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Resource Limits
# -----------------------------------------------------------------------------
CPU_LIMIT=2
MEMORY_LIMIT=2g

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# API key for protecting endpoints (optional — leave empty for no auth)
# When set, all API requests must include X-API-Key header or ?api_key= param
# Dashboard URL will need: http://localhost:8800/api/v1/dashboard?api_key=YOUR_KEY
# MCP client needs: CLAUDE_MCP_API_KEY=YOUR_KEY
# API_KEY=my-secret-key-here
# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*

# ── Optional HTTPS (docker compose --profile https up -d) ────────────────────────────
# Only needed to enable BROWSER NOTIFICATIONS away from localhost. The Notification API
# requires a secure context: `localhost` already is one, but reaching the dashboard over
# the LAN (or from a phone) is not, and the browser then refuses to enable notifications
# at all.
#
# Caddy terminates TLS with a locally-managed CA and proxies dashboard + API + WebSocket
# through ONE origin (an https page cannot talk to ws:// or http:// — mixed content).
#
# USE HOSTNAMES, NOT BARE IPs. A client connecting to an IP sends no SNI, and behind
# Docker's port forward Caddy then sees the container's own IP rather than the host's, so
# the handshake fails. Hostnames travel in SNI and survive the NAT.
#HTTPS_PORT=8443
#HTTPS_SITES=localhost:8443, 127.0.0.1:8443, myhost:8443, myhost.local:8443
