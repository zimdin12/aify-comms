# =============================================================================
# aify-comms — dashboard-driven agent communication and control plane
# =============================================================================
# Copy to .env: cp .env.example .env
# Then: docker compose up -d --build

# -----------------------------------------------------------------------------
# Service Identity
# -----------------------------------------------------------------------------
SERVICE_NAME=aify-comms
# SERVICE_VERSION is derived from the repo-root VERSION file, baked into
# service/_build_stamp.json by scripts/stamp.sh. Setting it here OVERRIDES that
# (env wins over the stamp) and pins the version reported by /, /docs and
# /openapi.json to whatever is typed here — which is how the API kept announcing
# 0.1.0 across the v0.1, v0.1.1 and v0.1.2 releases. Leave it commented.
# SERVICE_VERSION=0.1.0
SERVICE_DESCRIPTION=Dashboard and bridge for spawning, messaging, monitoring, and controlling headless coding agents across connected environments

# -----------------------------------------------------------------------------
# Network / Ports
# -----------------------------------------------------------------------------
# Dashboard: http://localhost:8800/api/v1/dashboard
# API:       http://localhost:8800/api/v1/
SERVICE_PORT=8800

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=aify-comms
DATA_VOLUME_NAME=aify-comms-data
DATA_VOLUME_EXTERNAL=false
RESTART_POLICY=unless-stopped

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
MCP_ENABLED=true
MCP_APP_NAME=claude-code

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Resource Limits
# -----------------------------------------------------------------------------
CPU_LIMIT=2
MEMORY_LIMIT=2g

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# API key for protecting endpoints (optional — leave empty for no auth)
# When set, all API requests must include X-API-Key header or ?api_key= param
# Dashboard URL will need: http://localhost:8800/api/v1/dashboard?api_key=YOUR_KEY
# MCP client needs: CLAUDE_MCP_API_KEY=YOUR_KEY
# API_KEY=my-secret-key-here
# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*

# ── Optional HTTPS (docker compose --profile https up -d) ────────────────────────────
# Only needed to enable BROWSER NOTIFICATIONS away from localhost. The Notification API
# requires a secure context: `localhost` already is one, but reaching the dashboard over
# the LAN (or from a phone) is not, and the browser then refuses to enable notifications
# at all.
#
# Caddy terminates TLS with a locally-managed CA and proxies dashboard + API + WebSocket
# through ONE origin (an https page cannot talk to ws:// or http:// — mixed content).
#
# A BARE IP NEEDS HTTPS_DEFAULT_SNI. RFC 6066 forbids putting an IP literal in SNI, so a browser
# reaching `https://192.168.0.10:8801` sends no name and Caddy has nothing to select a certificate
# on. Measured 2026-09-02: Caddy had ISSUED a certificate for the address and still failed the
# handshake with a TLS internal-error alert, logging nothing; the same connection with `-servername`
# set succeeded, which is what named SNI as the cause. (The earlier note here blamed Docker's port
# forward making Caddy see the container's own IP. That was wrong -- the certificate was correct and
# the selection was what failed.) A hostname needs none of this and is still the better route where
# DNS or mDNS resolves it.
#
# HTTPS_PORT MUST MATCH THE PORT INSIDE HTTPS_SITES. Caddy listens on whatever its site addresses
# name, and compose publishes HTTPS_PORT on both sides, so a mismatch maps a host port onto a
# container port nothing is listening on -- connection refused, every container healthy.
#HTTPS_PORT=8443
#HTTPS_SITES=localhost:8443, 127.0.0.1:8443, myhost:8443, myhost.local:8443
#HTTPS_DEFAULT_SNI=192.168.0.10

# The plain-HTTP dashboard. NOT 8802: that is aify-env's DEFAULT_PORT, and aify-env binds loopback,
# so it SHADOWS a Docker publish on the same port rather than colliding loudly with it --
# `test_aify_env_default_port_is_free_of_this_stack` reads this file for exactly that reason.
# Set this when HTTPS_PORT has taken 8801.
#NEW_DASHBOARD_PORT=8811
#AIFY_DASHBOARD_PORT=8811

# Proves a caller may act on ANOTHER agent's rows: unsend, channel delete, artifact delete.
# SEPARATE from API_KEY on purpose — every bridge holds API_KEY, so it can never distinguish the
# dashboard from an agent. Before 2026-08-18 these actions were granted on the actor STRING alone,
# so any caller could pass requestedBy="operator" and delete anything (R5-H1).
# Empty means NO caller can claim operator privilege — the dashboard's delete controls will refuse
# with a message naming this setting. Generate one with:  openssl rand -hex 32
OPERATOR_KEY=
