# Environment and secrets
.env
config/service.json

# Docker override (local customizations)
docker-compose.override.yml

# Per-build SHA stamp (regenerated by scripts/stamp.sh before each build).
# A placeholder is committed via `git add -f` so a fresh checkout still parses;
# this entry keeps the per-build regenerated values out of the diff.
service/_build_stamp.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

# Node
node_modules/
mcp/stdio/node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code (keep .claude/commands/ and .claude/skills/ — those are portable)
.claude/settings*
.claude/projects/
.claude/agents/
.claude/helpers/

# Claude-flow / ruflo runtime data
.claude-flow/
.swarm/

# Message bus (local mode runtime data)
.messages/
mcp/stdio/.messages/

# Agent identity file (written by comms_register)
.aify-agent

# MCP config (user-specific, root level only — .claude-plugin/.mcp.json is tracked)
/.mcp.json

# Local wrapper/install artifacts generated by Hermes/aify integration setup
/config.yaml
/agent-hooks/

# Logs
*.log
logs/

# Data (persisted in volumes, not git). ANCHORED to the repo root on purpose: a bare `data/`
# also matched service/tests/data/, which silently un-tracked the route-surface SNAPSHOTS that
# test_route_inventory.py and test_route_metadata_inventory.py compare against. The tests then
# passed locally off ignored files and failed on a clean clone with FileNotFoundError -- so the
# central gate of the v0.5.x domain phase was not actually in the repository.
/data/
v1-export.json

# Debug dumps
dispatch_runs.json
*.dispatch.json
.aify-graph/

# Scratch / screenshots (operator + debugging artifacts, never part of the repo)
Screenshot_*.png
/_*.json
/_dash_extracted.js

# local debug screenshots (never publish)
/.dash-shots/
/Screenshot_*.png
/*.png

# Local HTTPS CA export (docker compose --profile https). Regenerable from the caddy-data volume;
# not a secret, but not source either.
certs/
.monitor/
