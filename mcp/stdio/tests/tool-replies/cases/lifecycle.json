  {
    "name": "restart a managed agent's live session",
    "tool": "comms_restart",
    "args": {
      "agentId": "agent-b"
    },
    "routes": {
      "GET /agents/agent-b": {
        "body": {
          "agent": {
            "sessionMode": "managed"
          }
        }
      },
      "GET /sessions?agentId=agent-b": {
        "body": {
          "sessions": [
            {
              "id": "s0",
              "status": "ended"
            },
            {
              "id": "s1",
              "status": "Running"
            }
          ]
        }
      },
      "POST /sessions/s1/control": {
        "body": {
          "ok": true
        }
      }
    },
    "requests": [
      {
        "method": "GET",
        "path": "/agents/agent-b",
        "body": null
      },
      {
        "method": "GET",
        "path": "/sessions?agentId=agent-b",
        "body": null
      },
      {
        "method": "POST",
        "path": "/sessions/s1/control",
        "body": {
          "action": "restart",
          "from_agent": "agent-a"
        }
      }
    ],
    "text": "Managed session for \"agent-b\" restarted (session s1, action=restart); the live worker is stopped and aify-env starts the replacement.",
    "isError": false
  },
